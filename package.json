{
  "name": "product-crud-cypress-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --env-file-if-exists=.env node_modules/cypress/bin/cypress run --component",
    "test:record": "node --env-file-if-exists=.env node_modules/cypress/bin/cypress run --component --record",
    "test:parallel": "node --env-file-if-exists=.env scripts/run-parallel.mjs",
    "cy:open": "node --env-file-if-exists=.env node_modules/cypress/bin/cypress open --component",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,json}\" \"cypress/**/*.{ts,tsx,json}\"",
    "prettier:fix": "prettier --write \"src/**/*.{ts,tsx,json}\" \"cypress/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^5.14.13",
    "@mui/material": "^5.15.10",
    "@reduxjs/toolkit": "^2.2.3",
    "i18next": "^23.7.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "7.51.5",
    "react-i18next": "^14.0.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.0.2",
    "cypress": "^15.17.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "vite": "^8.3.5"
  }
}
